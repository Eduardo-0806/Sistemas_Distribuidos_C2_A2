# Copie para .env:  cp .env.example .env
# O docker compose le este arquivo automaticamente.

# --- LLM ---------------------------------------------------------------
# Deixe LLM_API_KEY vazia para usar o MODO SIMULADO (offline, sem custo).
# NUNCA coloque a chave no codigo nem faca commit do .env.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODELO=gpt-4o-mini

# --- Resiliencia da chamada ao LLM (servico de geracao) -----------------
# tempo-limite de cada tentativa, em segundos
LLM_TIMEOUT=20
# tentativas por pergunta (recuo exponencial entre elas)
LLM_TENTATIVAS=3
# perguntas que falharam seguidas para ABRIR o disjuntor
LLM_LIMITE_FALHAS=3
# segundos aberto antes de liberar a chamada de teste (meio aberto)
LLM_ESPERA_SEGUNDOS=20

# --- Enderecos (so para rodar fora do Docker; no compose ja vem prontos) --
URL_INGESTAO=http://localhost:8001
URL_RECUPERACAO=http://localhost:8002
REDIS_URL=redis://localhost:6379/0
